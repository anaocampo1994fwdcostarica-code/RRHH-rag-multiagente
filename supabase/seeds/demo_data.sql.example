-- =====================================================================================
-- DATOS DE DEMOSTRACIÓN — NO ES UNA MIGRACIÓN.
-- Aplicar SOLO en el proyecto Supabase de pruebas, desde el SQL Editor, después de la migración
-- 20261120090000_add_hr_operational_data.sql. Todo es ficticio: "Café Volcán Demo S.A.".
--
-- Marcas de demostración:
--   * Colaboradores con employee_code 'DEMO-001' … 'DEMO-054'.
--   * Departamentos y puestos con código 'DEMO_…' y descripción 'DEMO: …'.
--   * Solicitudes con reason que empieza por '[DEMO]'.
--
-- Idempotente: se puede ejecutar varias veces. Los datos maestros se actualizan con ON CONFLICT y
-- los movimientos demo (solicitudes, saldos, incapacidades, movimientos, evaluaciones) se borran y se
-- regeneran. Las fechas son relativas a HOY EN COSTA RICA, (now() at time zone 'America/Costa_Rica')::date;
-- si se ejecuta el 19/11/2026 los movimientos cubren del 19/08/2026 al 19/11/2026.
-- El calendario de pagos usa fechas fijas.
--
-- Usuarios de prueba: se buscan por correo en auth.users (solo lectura). No se crean usuarios ni roles.
-- Edita la tabla demo_test_users (sección 1) si tus correos son otros.
-- =====================================================================================

begin;

-- 0. Utilidades de sesión (pg_temp desaparece al cerrar la sesión).
create or replace function pg_temp.demo_today() returns date
language sql stable as $$ select (now() at time zone 'America/Costa_Rica')::date $$;

-- UUID determinista a partir de una clave legible.
create or replace function pg_temp.demo_id(p_key text) returns uuid
language sql immutable as $$ select md5('demo:' || p_key)::uuid $$;

-- Días hábiles lunes a viernes, inclusive (misma regla que el reporte y el agente de datos).
create or replace function pg_temp.demo_business_days(p_start date, p_end date) returns integer
language sql immutable as $$
  select count(*)::integer from generate_series(p_start, p_end, interval '1 day') d where extract(isodow from d) < 6
$$;

-- Fecha y hora local de Costa Rica convertida a timestamptz.
create or replace function pg_temp.demo_cr_ts(p_date date, p_time time) returns timestamptz
language sql immutable as $$ select (p_date + p_time) at time zone 'America/Costa_Rica' $$;

-- Lunes de la semana de una fecha.
create or replace function pg_temp.demo_monday(p_date date) returns date
language sql immutable as $$ select p_date - (extract(isodow from p_date)::integer - 1) $$;

-- 1. Usuarios de prueba a vincular (edita los correos si es necesario).
create temporary table demo_test_users (email text, employee_code text, department_code text, full_name text) on commit drop;
insert into demo_test_users values
  ('rls.employee.a@test.invalid', 'RLS-TEST-EMP-A', 'DEMO_TI', 'Colaborador de prueba A (demo)'),
  ('rls.employee.b@test.invalid', 'RLS-TEST-EMP-B', 'DEMO_COM', 'Colaborador de prueba B (demo)'),
  ('rls.hr@test.invalid', 'DEMO-011', null, null),
  ('rls.admin@test.invalid', 'DEMO-002', null, null);

-- 2. Departamentos (6) y puestos.
insert into public.departments (id, code, name, description)
select pg_temp.demo_id('dept:' || code), code, name, 'DEMO: departamento ficticio de Café Volcán Demo S.A.'
from (values
  ('DEMO_DIR', 'Dirección General'),
  ('DEMO_TH', 'Talento Humano'),
  ('DEMO_FIN', 'Finanzas'),
  ('DEMO_TI', 'Tecnología'),
  ('DEMO_PRO', 'Producción'),
  ('DEMO_COM', 'Comercial y Logística')
) as d(code, name)
on conflict (code) do update set name = excluded.name, description = excluded.description, is_active = true, archived_at = null;

insert into public.positions (id, department_id, code, name, description)
select pg_temp.demo_id('pos:' || d.code || p.suffix), d.id, d.code || p.suffix,
  case when d.code = 'DEMO_DIR' and p.suffix = '_JEFE' then 'Gerencia General' else p.prefix || d.name end,
  'DEMO: puesto ficticio'
from public.departments d
cross join (values ('_JEFE', 'Jefatura de '), ('_ANALISTA', 'Analista de '), ('_ASISTENTE', 'Asistente de ')) as p(suffix, prefix)
where d.code like 'DEMO\_%'
on conflict (code) do update set name = excluded.name, description = excluded.description, is_active = true, archived_at = null;

-- 3. Tipos de permiso (se reutilizan si ya existen).
insert into public.leave_types (code, name, requires_attachment) values
  ('vacaciones', 'Vacaciones', false),
  ('permiso_personal', 'Permiso personal', false),
  ('cita_medica', 'Cita médica', true),
  ('duelo', 'Permiso por duelo', false)
on conflict do nothing;

-- 4. Colaboradores demo: 54 = 6 departamentos × 9. El primero de cada bloque es la jefatura.
create temporary table demo_people on commit drop as
with base as (
  select n,
    (array['Ana','Luis','María','José','Carolina','Andrés','Daniela','Esteban','Gabriela','Mauricio','Valeria','Kevin','Natalia','Diego','Fernanda','Pablo','Melissa','Jorge','Rebeca','Adrián','Paola','Sergio','Tatiana','Marco','Laura','Bryan','Silvia','Randall','Diana','Josué','Karla','Óscar','Mónica','Rafael','Andrea','Cristian','Patricia','Allan','Raquel','Jonathan','Verónica','Felipe','Sofía','Gerardo','Marcela','Ricardo','Priscilla','Alonso','Isabel','Emmanuel','Lucía','Roberto','Elena','Manuel'])[n] as first_name,
    (array['Rojas','Vargas','Jiménez','Mora','Solano','Araya','Chaves','Quesada','Alfaro','Brenes','Calderón','Castro','Salazar','Ramírez','Villalobos','Hernández','Arias','Sánchez','Méndez','Zúñiga','Badilla','Cordero','Monge','Picado','Ulate','Segura','Aguilar','Porras','Valverde','Murillo'])[1 + ((n * 7) % 30)] as last1,
    (array['Rojas','Vargas','Jiménez','Mora','Solano','Araya','Chaves','Quesada','Alfaro','Brenes','Calderón','Castro','Salazar','Ramírez','Villalobos','Hernández','Arias','Sánchez','Méndez','Zúñiga','Badilla','Cordero','Monge','Picado','Ulate','Segura','Aguilar','Porras','Valverde','Murillo'])[1 + ((n * 11 + 3) % 30)] as last2
  from generate_series(1, 54) as n
)
select
  n as i,
  'DEMO-' || lpad(n::text, 3, '0') as code,
  first_name || ' ' || last1 || ' ' || last2 as full_name,
  (array['DEMO_DIR','DEMO_TH','DEMO_FIN','DEMO_TI','DEMO_PRO','DEMO_COM'])[((n - 1) / 9) + 1] as department_code,
  ((n - 1) % 9) + 1 as k,
  n in (18, 45) as is_exit,          -- salidas en el mes
  n in (27, 36, 54) as is_new_hire,  -- ingresos en el mes
  n = 23 as is_maternity             -- incapacidad por maternidad activa
from base;

insert into public.employees (id, employee_code, full_name, department_id, position_id, employment_status, hired_on, ended_on, deleted_at)
select
  pg_temp.demo_id('emp:' || p.code),
  p.code,
  p.full_name,
  d.id,
  pos.id,
  case when p.is_exit then 'inactive' when p.is_maternity then 'on_leave' else 'active' end,
  case when p.is_new_hire then greatest(date_trunc('month', pg_temp.demo_today())::date, pg_temp.demo_today() - (p.i % 10 + 3))
       else date '2015-01-05' + ((p.i * 97) % 3400) end,
  case when p.is_exit then greatest(date_trunc('month', pg_temp.demo_today())::date, pg_temp.demo_today() - (p.i % 5 + 1)) end,
  null
from demo_people p
join public.departments d on d.code = p.department_code
join public.positions pos on pos.code = p.department_code || case when p.k = 1 then '_JEFE' when p.k <= 5 then '_ANALISTA' else '_ASISTENTE' end
on conflict (employee_code) do update set
  full_name = excluded.full_name,
  department_id = excluded.department_id,
  position_id = excluded.position_id,
  employment_status = excluded.employment_status,
  hired_on = excluded.hired_on,
  ended_on = excluded.ended_on,
  deleted_at = null;
  -- profile_id no se toca: conserva los vínculos con usuarios de prueba.

-- Jefaturas: las de departamento reportan a la Gerencia General (DEMO-001); el resto a su jefatura.
update public.employees e
set manager_employee_id = case
  when p.i = 1 then null
  when p.k = 1 then (select id from public.employees where employee_code = 'DEMO-001')
  else (select id from public.employees where employee_code = 'DEMO-' || lpad((p.i - p.k + 1)::text, 3, '0'))
end
from demo_people p
where e.employee_code = p.code;

-- 5. Vincular usuarios de prueba mediante profile_id (sin crear usuarios de auth).
do $$
declare
  r record;
  v_profile uuid;
  v_linked_code text;
begin
  for r in select * from demo_test_users loop
    select p.id into v_profile
    from auth.users u join public.profiles p on p.id = u.id
    where lower(u.email) = lower(r.email);

    if v_profile is null then
      raise notice 'DEMO: el usuario % no existe; se omite.', r.email;
      continue;
    end if;

    select employee_code into v_linked_code from public.employees where profile_id = v_profile and deleted_at is null;
    if v_linked_code is not null and v_linked_code <> r.employee_code then
      raise notice 'DEMO: % ya está vinculado a %; no se cambia.', r.email, v_linked_code;
      continue;
    end if;

    if r.employee_code like 'RLS-TEST-EMP-%' then
      -- El harness RLS exige estos códigos. Si ya existen, se conservan departamento y puesto.
      insert into public.employees as e (employee_code, profile_id, full_name, department_id, position_id, manager_employee_id, employment_status, hired_on)
      select r.employee_code, v_profile, r.full_name, d.id, pos.id,
        (select id from public.employees where employee_code = case r.department_code when 'DEMO_TI' then 'DEMO-028' else 'DEMO-046' end),
        'active', date '2023-02-01'
      from public.departments d
      join public.positions pos on pos.code = d.code || '_ANALISTA'
      where d.code = r.department_code
      on conflict (employee_code) do update set
        profile_id = coalesce(e.profile_id, excluded.profile_id),
        full_name = coalesce(e.full_name, excluded.full_name),
        manager_employee_id = coalesce(e.manager_employee_id, excluded.manager_employee_id);
    else
      update public.employees set profile_id = v_profile
      where employee_code = r.employee_code and (profile_id is null or profile_id = v_profile);
    end if;
  end loop;
end;
$$;

-- Alcance de los datos demo: colaboradores DEMO-* y los dos de prueba.
create temporary table demo_scope on commit drop as
select e.id as employee_id, e.employee_code as code, e.hired_on, e.ended_on, e.employment_status,
  coalesce(p.i, case e.employee_code when 'RLS-TEST-EMP-A' then 101 else 102 end) as i,
  coalesce(p.is_exit, false) as is_exit,
  coalesce(p.is_new_hire, false) as is_new_hire,
  e.employee_code like 'RLS-TEST-EMP-%' as is_test_user
from public.employees e
left join demo_people p on p.code = e.employee_code
where e.deleted_at is null
  and (e.employee_code like 'DEMO-%' or e.employee_code in ('RLS-TEST-EMP-A', 'RLS-TEST-EMP-B'));

-- 6. Limpieza de movimientos demo (historial primero: la FK es ON DELETE RESTRICT).
delete from public.leave_request_status_history h
using public.leave_requests lr
where h.request_id = lr.id
  and lr.reason like '[DEMO]%'
  and lr.employee_id in (select employee_id from demo_scope);
delete from public.leave_requests
where reason like '[DEMO]%' and employee_id in (select employee_id from demo_scope);
delete from public.vacation_balances where employee_id in (select employee_id from demo_scope);
delete from public.sick_leaves where employee_id in (select employee_id from demo_scope);
delete from public.personnel_movements where employee_id in (select employee_id from demo_scope);
delete from public.performance_reviews where employee_id in (select employee_id from demo_scope);

-- 7. Solicitudes de permiso (todas las reglas usan la fecha de Costa Rica).
create temporary table demo_requests (
  employee_id uuid, rule text, leave_type_code text, start_date date, end_date date,
  status text, submitted_at timestamptz, resolved_at timestamptz, reason text
) on commit drop;

-- 7.1 Vacaciones aprobadas pasadas (lunes a viernes, dentro de los últimos 3 meses). Cuentan en el saldo.
insert into demo_requests
select s.employee_id, 'vac_past', 'vacaciones', m.start_date, m.start_date + (s.i % 5),
  'approved', pg_temp.demo_cr_ts(m.start_date - 10, '09:00'), pg_temp.demo_cr_ts(m.start_date - 8, '14:00'),
  '[DEMO] Vacaciones programadas'
from demo_scope s
cross join lateral (select pg_temp.demo_monday(pg_temp.demo_today() - (20 + (s.i * 5) % 65)) as start_date) m
where s.i % 3 = 0 and not s.is_exit and not s.is_new_hire and not s.is_test_user;

-- 7.2 Ausencias que caen HOY (vacaciones aprobadas de ayer a pasado mañana). Cuentan en el saldo.
insert into demo_requests
select s.employee_id, 'vac_today', 'vacaciones', pg_temp.demo_today() - 1, pg_temp.demo_today() + 2,
  'approved', pg_temp.demo_cr_ts(pg_temp.demo_today() - 15, '10:00'), pg_temp.demo_cr_ts(pg_temp.demo_today() - 12, '15:00'),
  '[DEMO] Vacaciones familiares'
from demo_scope s
where s.code in ('DEMO-005', 'DEMO-014', 'DEMO-030', 'DEMO-041');

-- 7.3 Permisos aprobados que no son vacaciones (no afectan el saldo).
insert into demo_requests
select s.employee_id, 'permit_approved', case when s.i % 2 = 0 then 'cita_medica' else 'duelo' end,
  pg_temp.demo_today() - (15 + s.i % 60), pg_temp.demo_today() - (15 + s.i % 60),
  'approved', pg_temp.demo_cr_ts(pg_temp.demo_today() - (18 + s.i % 60), '08:30'), pg_temp.demo_cr_ts(pg_temp.demo_today() - (17 + s.i % 60), '11:00'),
  '[DEMO] Permiso aprobado'
from demo_scope s
where s.i % 7 = 0 and not s.is_new_hire and not s.is_test_user;

-- 7.4 Pendientes ANTIGUAS: submitted_at hace 4 a 7 días (> 3 días según submitted_at).
insert into demo_requests
select s.employee_id, 'pending_old', 'vacaciones', pg_temp.demo_today() + 14 + s.i % 10, pg_temp.demo_today() + 16 + s.i % 10,
  'submitted', pg_temp.demo_cr_ts(pg_temp.demo_today() - (4 + s.i % 4), '09:00'), null,
  '[DEMO] Solicitud pendiente de revisión'
from demo_scope s
where s.i % 7 = 1 and not s.is_exit and not s.is_test_user;

-- 7.5 En revisión: submitted_at hace 5 a 7 días.
insert into demo_requests
select s.employee_id, 'in_review', 'permiso_personal', pg_temp.demo_today() + 7 + s.i % 5, pg_temp.demo_today() + 7 + s.i % 5,
  'in_review', pg_temp.demo_cr_ts(pg_temp.demo_today() - (5 + s.i % 3), '10:30'), null,
  '[DEMO] Permiso en revisión'
from demo_scope s
where s.i % 7 = 2 and not s.is_exit and not s.is_test_user;

-- 7.6 Pendientes RECIENTES: submitted_at hace 0 a 2 días (no deben contar como > 3 días).
insert into demo_requests
select s.employee_id, 'pending_recent', 'vacaciones', pg_temp.demo_today() + 20 + s.i % 10, pg_temp.demo_today() + 21 + s.i % 10,
  'submitted', pg_temp.demo_cr_ts(pg_temp.demo_today() - (s.i % 3), '08:00'), null,
  '[DEMO] Solicitud reciente'
from demo_scope s
where s.i % 7 = 3 and not s.is_exit and not s.is_test_user;

-- 7.7 Rechazadas (pasadas).
insert into demo_requests
select s.employee_id, 'rejected', 'vacaciones', pg_temp.demo_today() - (30 + s.i % 40), pg_temp.demo_today() - (29 + s.i % 40),
  'rejected', pg_temp.demo_cr_ts(pg_temp.demo_today() - (45 + s.i % 40), '09:00'), pg_temp.demo_cr_ts(pg_temp.demo_today() - (43 + s.i % 40), '16:00'),
  '[DEMO] Solicitud rechazada por cierre contable'
from demo_scope s
where s.i % 7 = 4 and not s.is_new_hire and not s.is_test_user;

-- 7.8 Canceladas (pasadas).
insert into demo_requests
select s.employee_id, 'cancelled', 'permiso_personal', pg_temp.demo_today() - (10 + s.i % 50), pg_temp.demo_today() - (10 + s.i % 50),
  'cancelled', pg_temp.demo_cr_ts(pg_temp.demo_today() - (20 + s.i % 50), '09:00'), pg_temp.demo_cr_ts(pg_temp.demo_today() - (18 + s.i % 50), '09:30'),
  '[DEMO] Solicitud cancelada por la persona'
from demo_scope s
where s.i % 7 = 5 and not s.is_new_hire and not s.is_test_user;

-- 7.9 Borradores (sin submitted_at).
insert into demo_requests
select s.employee_id, 'draft', 'vacaciones', pg_temp.demo_today() + 30 + s.i % 15, pg_temp.demo_today() + 32 + s.i % 15,
  'draft', null, null, '[DEMO] Borrador'
from demo_scope s
where s.i % 7 = 6 and not s.is_exit and not s.is_test_user;

-- 7.10 Usuarios de prueba: vacaciones aprobadas, pendiente antigua y permiso del próximo viernes (pregunta 18).
insert into demo_requests
select s.employee_id, 'test_vac', 'vacaciones', m.start_date, m.start_date + 1,
  'approved', pg_temp.demo_cr_ts(m.start_date - 9, '09:00'), pg_temp.demo_cr_ts(m.start_date - 7, '12:00'), '[DEMO] Vacaciones de prueba'
from demo_scope s
cross join lateral (select pg_temp.demo_monday(pg_temp.demo_today() - 35) as start_date) m
where s.is_test_user
union all
select s.employee_id, 'test_friday', 'permiso_personal', f.friday, f.friday,
  'submitted', pg_temp.demo_cr_ts(pg_temp.demo_today() - 4, '11:00'), null, '[DEMO] Permiso del viernes'
from demo_scope s
cross join lateral (select pg_temp.demo_monday(pg_temp.demo_today()) + 4 + case when extract(isodow from pg_temp.demo_today()) >= 5 then 7 else 0 end as friday) f
where s.is_test_user;

insert into public.leave_requests (id, employee_id, leave_type_id, start_date, end_date, reason, status, submitted_at, resolved_at, created_at)
select pg_temp.demo_id('lr:' || r.employee_id || ':' || r.rule), r.employee_id, lt.id, r.start_date, r.end_date, r.reason, r.status,
  r.submitted_at, r.resolved_at, coalesce(r.submitted_at - interval '1 hour', pg_temp.demo_cr_ts(pg_temp.demo_today() - 1, '17:00'))
from demo_requests r
join public.leave_types lt on lt.code = r.leave_type_code;

-- 8. Saldos de vacaciones: taken_days = días hábiles de vacaciones APROBADAS del mismo periodo.
create temporary table demo_taken on commit drop as
select lr.employee_id, extract(year from lr.start_date)::integer as period,
  sum(pg_temp.demo_business_days(lr.start_date, lr.end_date))::integer as taken_days
from public.leave_requests lr
join public.leave_types lt on lt.id = lr.leave_type_id and lt.code = 'vacaciones'
where lr.status = 'approved' and lr.deleted_at is null and lr.employee_id in (select employee_id from demo_scope)
group by 1, 2;

insert into public.vacation_balances (id, employee_id, period, assigned_days, taken_days)
select pg_temp.demo_id('vb:' || p.employee_id || ':' || p.period), p.employee_id, p.period,
  greatest(
    case
      -- Ingresos del año: asignación proporcional.
      when s.hired_on > make_date(p.period, 1, 1) then round(14 * (make_date(p.period, 12, 31) - s.hired_on) / 365.0)::integer
      else 14
    end,
    coalesce(t.taken_days, 0)
  ),
  coalesce(t.taken_days, 0)
from (
  select employee_id, extract(year from pg_temp.demo_today())::integer as period from demo_scope where not is_exit
  union
  select employee_id, period from demo_taken
  union
  -- Personas con periodo anterior sin disfrutar (acumulan más de 20 días).
  select employee_id, extract(year from pg_temp.demo_today())::integer - 1 from demo_scope
  where code in ('DEMO-007', 'DEMO-016', 'DEMO-025', 'DEMO-034')
) as p
join demo_scope s on s.employee_id = p.employee_id
left join demo_taken t on t.employee_id = p.employee_id and t.period = p.period;

-- 9. Incapacidades: activas hoy y pasadas dentro de la ventana de 3 meses.
insert into public.sick_leaves (id, employee_id, type, start_date, days, entity)
select pg_temp.demo_id('sl:' || v.code || ':' || v.label), s.employee_id, v.type, pg_temp.demo_today() + v.start_offset, v.days, v.entity
from (values
  ('DEMO-008', 'activa_enfermedad', 'enfermedad', -2, 5, 'CCSS'),
  ('DEMO-020', 'activa_accidente', 'accidente_laboral', -10, 30, 'INS'),
  ('DEMO-023', 'activa_maternidad', 'maternidad', -40, 120, 'CCSS'),
  ('DEMO-050', 'activa_hoy', 'enfermedad', 0, 3, 'empresa'),
  ('DEMO-003', 'pasada_1', 'enfermedad', -90, 3, 'empresa'),
  ('DEMO-012', 'pasada_2', 'enfermedad', -66, 7, 'CCSS'),
  ('DEMO-019', 'pasada_3', 'accidente_laboral', -58, 12, 'INS'),
  ('DEMO-031', 'pasada_4', 'enfermedad', -44, 2, 'empresa'),
  ('DEMO-038', 'pasada_5', 'enfermedad', -30, 4, 'CCSS'),
  ('DEMO-047', 'pasada_6', 'enfermedad', -21, 3, 'empresa'),
  ('DEMO-052', 'pasada_7', 'accidente_laboral', -15, 8, 'INS'),
  ('RLS-TEST-EMP-A', 'pasada_prueba', 'enfermedad', -50, 3, 'empresa')
) as v(code, label, type, start_offset, days, entity)
join demo_scope s on s.code = v.code;

-- 10. Movimientos de personal (ingresos y salidas del mes, más historial de 3 meses).
insert into public.personnel_movements (id, employee_id, type, movement_date, reason)
select pg_temp.demo_id('pm:' || s.code || ':ingreso'), s.employee_id, 'ingreso', s.hired_on, '[DEMO] Contratación nueva'
from demo_scope s where s.is_new_hire
union all
select pg_temp.demo_id('pm:' || s.code || ':salida'), s.employee_id, 'salida', s.ended_on, '[DEMO] Renuncia voluntaria'
from demo_scope s where s.is_exit
union all
select pg_temp.demo_id('pm:' || v.code || ':' || v.type), s.employee_id, v.type, pg_temp.demo_today() + v.offset_days, v.reason
from (values
  ('DEMO-013', 'ascenso', -92, '[DEMO] Ascenso a analista sénior'),
  ('DEMO-029', 'ascenso', -52, '[DEMO] Ascenso por evaluación sobresaliente'),
  ('DEMO-040', 'ascenso', -33, '[DEMO] Cambio a coordinación de turno')
) as v(code, type, offset_days, reason)
join demo_scope s on s.code = v.code;

-- 11. Evaluaciones de desempeño: próxima programada para todos los activos y algunas completadas.
insert into public.performance_reviews (id, employee_id, scheduled_date, status)
select pg_temp.demo_id('pr:' || s.code || ':next'), s.employee_id, pg_temp.demo_today() + 1 + (s.i * 13) % 75, 'programada'
from demo_scope s where not s.is_exit
union all
select pg_temp.demo_id('pr:' || s.code || ':done'), s.employee_id, pg_temp.demo_today() - (10 + s.i % 60), 'completada'
from demo_scope s where s.i % 4 = 0 and not s.is_new_hire;

-- 12. Calendario de pagos quincenal (fechas fijas) y aguinaldo.
insert into public.payroll_calendar (id, pay_date, period_label, type)
select pg_temp.demo_id('pay:' || v.pay_date || ':' || v.type), v.pay_date::date, v.label, v.type
from (values
  ('2026-08-14', 'Primera quincena de agosto 2026', 'quincenal'),
  ('2026-08-31', 'Segunda quincena de agosto 2026', 'quincenal'),
  ('2026-09-15', 'Primera quincena de setiembre 2026', 'quincenal'),
  ('2026-09-30', 'Segunda quincena de setiembre 2026', 'quincenal'),
  ('2026-10-15', 'Primera quincena de octubre 2026', 'quincenal'),
  ('2026-10-30', 'Segunda quincena de octubre 2026', 'quincenal'),
  ('2026-11-13', 'Primera quincena de noviembre 2026', 'quincenal'),
  ('2026-11-30', 'Segunda quincena de noviembre 2026', 'quincenal'),
  ('2026-12-15', 'Primera quincena de diciembre 2026', 'quincenal'),
  ('2026-12-18', 'Aguinaldo 2026', 'aguinaldo'),
  ('2026-12-31', 'Segunda quincena de diciembre 2026', 'quincenal')
) as v(pay_date, label, type)
on conflict (pay_date, type) do update set period_label = excluded.period_label;

commit;

-- =====================================================================================
-- CONSULTAS DE VERIFICACIÓN (ejecútalas por separado: el SQL Editor muestra solo el último resultado).
-- Usan las mismas reglas que deben usar el reporte diario y el agente de datos.
-- =====================================================================================

-- V1. Resumen comparable con el reporte diario (métrica | valor).
with ctx as (select (now() at time zone 'America/Costa_Rica')::date as today),
scope as (
  select * from public.employees
  where deleted_at is null and (employee_code like 'DEMO-%' or employee_code in ('RLS-TEST-EMP-A', 'RLS-TEST-EMP-B'))
)
select metric, value from (
  select 1 as ord, 'colaboradores_demo_total' as metric, count(*)::text as value from scope
  union all select 2, 'colaboradores_activos', count(*)::text from scope where employment_status = 'active'
  union all select 3, 'departamentos_demo', count(*)::text from public.departments where code like 'DEMO\_%'
  union all select 4, 'ausentes_hoy_por_permiso_aprobado', count(distinct lr.employee_id)::text
    from public.leave_requests lr, ctx where lr.status = 'approved' and lr.deleted_at is null
      and ctx.today between lr.start_date and lr.end_date and lr.employee_id in (select id from scope)
  union all select 5, 'incapacidades_activas_hoy', count(*)::text
    from public.sick_leaves sl, ctx where ctx.today between sl.start_date and sl.end_date and sl.employee_id in (select id from scope)
  union all select 6, 'solicitudes_pendientes', count(*)::text
    from public.leave_requests where status in ('submitted', 'in_review') and deleted_at is null and employee_id in (select id from scope)
  union all select 7, 'solicitudes_pendientes_mas_de_3_dias', count(*)::text
    from public.leave_requests where status in ('submitted', 'in_review') and deleted_at is null
      and submitted_at < now() - interval '3 days' and employee_id in (select id from scope)
  union all select 8, 'ingresos_del_mes', count(*)::text
    from public.personnel_movements pm, ctx where pm.type = 'ingreso' and pm.movement_date >= date_trunc('month', ctx.today)::date
      and pm.movement_date <= ctx.today and pm.employee_id in (select id from scope)
  union all select 9, 'salidas_del_mes', count(*)::text
    from public.personnel_movements pm, ctx where pm.type = 'salida' and pm.movement_date >= date_trunc('month', ctx.today)::date
      and pm.movement_date <= ctx.today and pm.employee_id in (select id from scope)
  union all select 10, 'personas_con_mas_de_20_dias_acumulados', count(*)::text
    from (select employee_id from public.vacation_balances where employee_id in (select id from scope)
          group by employee_id having sum(available_days) > 20) acc
  union all select 11, 'proximo_pago', min(pay_date)::text from public.payroll_calendar, ctx where pay_date >= ctx.today
  union all select 12, 'movimientos_desde', min(d)::text from (
      select start_date as d from public.leave_requests where reason like '[DEMO]%'
      union all select movement_date from public.personnel_movements where reason like '[DEMO]%' and type <> 'ingreso'
    ) m
) metrics
order by ord;

-- V2. Coherencia saldo vs. solicitudes: debe devolver 0 filas.
with taken as (
  select lr.employee_id, extract(year from lr.start_date)::integer as period, sum(bd.days)::integer as days
  from public.leave_requests lr
  join public.leave_types lt on lt.id = lr.leave_type_id and lt.code = 'vacaciones'
  cross join lateral (
    select count(*) as days from generate_series(lr.start_date, lr.end_date, interval '1 day') d where extract(isodow from d) < 6
  ) bd
  where lr.status = 'approved' and lr.deleted_at is null
  group by 1, 2
)
select coalesce(vb.employee_id, t.employee_id) as employee_id, coalesce(vb.period, t.period) as period,
  vb.taken_days as saldo_taken_days, coalesce(t.days, 0) as dias_aprobados
from public.vacation_balances vb
full join taken t on t.employee_id = vb.employee_id and t.period = vb.period
where coalesce(vb.taken_days, -1) <> coalesce(t.days, 0);

