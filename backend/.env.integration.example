# Copy to .env.integration. This file is ignored and is only for the Supabase test project.
RLS_INTEGRATION_PROJECT_REF=bxtetlzjlgoezxcjhdrw

# Supabase Auth test project; publishable key only, never service_role.
SUPABASE_URL=https://bxtetlzjlgoezxcjhdrw.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_test_project_key

# Session Pooler only: port 5432 and dedicated rrhh_api.<project-ref> user.
# Keep the password local, URL-encoded and outside version control.
DATABASE_URL=postgresql://rrhh_api.bxtetlzjlgoezxcjhdrw:replace_with_database_password@your-session-pooler.pooler.supabase.com:5432/postgres
DATABASE_SSL_CA_FILE=C:/path/outside/repository/prod-supabase.crt

# Short-lived access tokens from the two existing fictitious employee accounts.
RLS_INTEGRATION_EMPLOYEE_A_ACCESS_TOKEN=replace_with_employee_a_access_token
RLS_INTEGRATION_EMPLOYEE_B_ACCESS_TOKEN=replace_with_employee_b_access_token
