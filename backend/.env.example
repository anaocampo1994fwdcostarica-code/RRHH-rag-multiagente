PORT=3001
FRONTEND_URL=http://localhost:5173

# Optional until the secure authentication and database integration stages.
# Use the test project URL; never expose DATABASE_URL to the frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_project_key

# Use the Session Pooler URL or approved direct connection for this backend only.
# Keep the password local and URL-encoded; this example is intentionally fictitious.
DATABASE_URL=postgresql://rrhh_api.your-project-ref:replace_with_database_password@your-session-pooler.pooler.supabase.com:5432/postgres

# Absolute path to the Supabase CA PEM certificate stored outside the repository.
DATABASE_SSL_CA_FILE=C:/path/outside/repository/prod-supabase.crt

# LLM y embeddings (por defecto OpenAI). Ver docs/DECISION_PROVEEDORES_LLM.md.
# LLM_PROVIDER: openai | deepseek | gemini · EMBEDDINGS_PROVIDER: openai | local (E5) | gemini
LLM_PROVIDER=openai
EMBEDDINGS_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=
# Opcional: esfuerzo de razonamiento (none = menor latencia) y plazo por llamada en ms.
OPENAI_REASONING_EFFORT=
OPENAI_TIMEOUT_MS=

# Alternativa (no se usa por defecto): DeepSeek o una plataforma compatible con OpenAI.
DEEPSEEK_API_KEY=
# URL base compatible con OpenAI (por defecto https://api.deepseek.com; puede ser una plataforma intermediaria).
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
DEEPSEEK_TIMEOUT_MS=6000
# Umbral de similitud coseno de match_policy_chunks. Vacío = valor inicial según EMBEDDINGS_PROVIDER
# (openai 0.45, local/E5 0.82, gemini 0.7). Se calibra en la sesión 4.
RAG_SIMILARITY_THRESHOLD=

# Opcional (no se usa por defecto). Server-only Gemini settings. Do not expose this key to the frontend or commit it.
# The providers are lazy: the backend public health endpoint starts without these values.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
# Opcional: modelo del clasificador del orquestador (por defecto, GEMINI_CHAT_MODEL).
GEMINI_CLASSIFIER_MODEL=gemini-2.5-flash

# Google Drive ingestion is disabled until invoked by an authorized document manager.
# Store the service-account private key outside the repository; use literal \n only
# when the deployment environment cannot preserve line breaks.
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=drive-reader@example.iam.gserviceaccount.com
GOOGLE_DRIVE_SERVICE_ACCOUNT_PRIVATE_KEY=replace_with_private_key_outside_git
GOOGLE_DRIVE_FOLDER_ID=replace_with_authorized_folder_id

# Keep disabled until the pgvector and editorial-review migrations are manually validated.
ENABLE_DOCUMENT_SYNC=false
